From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Codex <codex@openai.com>
Date: Fri, 26 Jun 2026 00:00:00 +0000
Subject: [PATCH] Add Android PyKrita SIP generate-only mode

Let Android experimental PyKrita builds stop after SIP 5+ source generation.
This gives the port a narrow build-tree probe for PyKrita SIP metadata before
linking the full Python module against Krita libraries.
---
 cmake/modules/SIPMacros.cmake | 57 +++++++++++++++++++++++------------
 1 file changed, 31 insertions(+), 26 deletions(-)

diff --git a/cmake/modules/SIPMacros.cmake b/cmake/modules/SIPMacros.cmake
index a350222..6eb7c18 100644
--- a/cmake/modules/SIPMacros.cmake
+++ b/cmake/modules/SIPMacros.cmake
@@ -243,34 +243,39 @@ else()
                 ${_sip_output_files} ${_complete_stubs}
         )
 
-        # not sure if type MODULE could be usec anywhere, limit to cygwin for now
-        if (WIN32 OR CYGWIN OR APPLE)
-            add_library(${_logical_name} MODULE ${_sip_output_files})
-        else ()
-            add_library(${_logical_name} SHARED ${_sip_output_files})
-        endif ()
-        target_include_directories(${_logical_name} PRIVATE ${CMAKE_CURRENT_SIP_OUTPUT_DIR})
-        target_link_libraries(${_logical_name} ${PYTHON_LIBRARY})
-        target_link_libraries(${_logical_name} ${EXTRA_LINK_LIBRARIES})
-        set_target_properties(${_logical_name} PROPERTIES PREFIX "" OUTPUT_NAME ${_child_module_name})
-
-        if (MINGW)
-            target_compile_definitions(${_logical_name} PRIVATE _hypot=hypot)
-        elseif(NOT MSVC)
-            # SIP v5+ redefines access to protected variables.
-            target_compile_definitions(${_logical_name} PRIVATE SIP_PROTECTED_IS_PUBLIC)
-            target_compile_definitions(${_logical_name} PRIVATE protected=public)
-        endif()
+        if(ANDROID AND ENABLE_ANDROID_PYKRITA_EXPERIMENTAL AND KRITA_ANDROID_PYKRITA_GENERATE_ONLY)
+            add_custom_target(${_logical_name}_sip_generate ALL
+                DEPENDS ${_sip_output_files} ${_complete_stubs})
+        else()
+            # not sure if type MODULE could be usec anywhere, limit to cygwin for now
+            if (WIN32 OR CYGWIN OR APPLE)
+                add_library(${_logical_name} MODULE ${_sip_output_files})
+            else ()
+                add_library(${_logical_name} SHARED ${_sip_output_files})
+            endif ()
+            target_include_directories(${_logical_name} PRIVATE ${CMAKE_CURRENT_SIP_OUTPUT_DIR})
+            target_link_libraries(${_logical_name} ${PYTHON_LIBRARY})
+            target_link_libraries(${_logical_name} ${EXTRA_LINK_LIBRARIES})
+            set_target_properties(${_logical_name} PROPERTIES PREFIX "" OUTPUT_NAME ${_child_module_name})
+
+            if (MINGW)
+                target_compile_definitions(${_logical_name} PRIVATE _hypot=hypot)
+            elseif(NOT MSVC)
+                # SIP v5+ redefines access to protected variables.
+                target_compile_definitions(${_logical_name} PRIVATE SIP_PROTECTED_IS_PUBLIC)
+                target_compile_definitions(${_logical_name} PRIVATE protected=public)
+            endif()
 
-        if(MSVC)
-            set_target_properties(${_logical_name} PROPERTIES PDB_NAME "sip_v5_${_logical_name}")
-        endif ()
+            if(MSVC)
+                set_target_properties(${_logical_name} PROPERTIES PDB_NAME "sip_v5_${_logical_name}")
+            endif ()
 
-        if (WIN32)
-            SET_TARGET_PROPERTIES(${_logical_name} PROPERTIES SUFFIX ".pyd")
-        ENDIF ()
+            if (WIN32)
+                SET_TARGET_PROPERTIES(${_logical_name} PROPERTIES SUFFIX ".pyd")
+            ENDIF ()
 
-        install(FILES ${_complete_stubs} DESTINATION "${PYTHON_SITE_PACKAGES_INSTALL_DIR}/${_parent_module_path}" RENAME "${_child_module_name}.pyi")
-        install(TARGETS ${_logical_name} DESTINATION "${PYTHON_SITE_PACKAGES_INSTALL_DIR}/${_parent_module_path}")
+            install(FILES ${_complete_stubs} DESTINATION "${PYTHON_SITE_PACKAGES_INSTALL_DIR}/${_parent_module_path}" RENAME "${_child_module_name}.pyi")
+            install(TARGETS ${_logical_name} DESTINATION "${PYTHON_SITE_PACKAGES_INSTALL_DIR}/${_parent_module_path}")
+        endif()
     endmacro()
 endif()
-- 
2.45.0
